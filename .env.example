# ==============================================================================
# CONFIGURAÇÃO DE PROVEDOR DE IA (LLM_PROVIDER)
# ==============================================================================
# Opções suportadas para LLM_PROVIDER:
#   - auto        : Detecta automaticamente na ordem: bootcamp -> gemini -> grok -> local -> antigravity
#   - bootcamp    : Gateway oficial da banca (BOOTCAMP_LLM_ENDPOINT + BOOTCAMP_API_KEY)
#   - gemini      : API direta do Google Gemini / AI Studio (GEMINI_API_KEY)
#   - grok        : API da xAI Grok (GROK_API_KEY)
#   - local       : IA Local via Ollama, LM Studio, vLLM ou Jan (LOCAL_LLM_URL)
#   - antigravity : Modo Agente Local / Antigravity (execução determinística + síntese contextual sem custo de API)
LLM_PROVIDER=auto

# ------------------------------------------------------------------ 1. Banca (Bootcamp Oficial)
# Credenciais injetadas pela banca no `docker run`
BOOTCAMP_LLM_ENDPOINT=
BOOTCAMP_API_KEY=

# ------------------------------------------------------------------ 2. Google Gemini API (Direta)
# Obtenha sua chave em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ------------------------------------------------------------------ 3. xAI Grok API
# Obtenha sua chave em: https://console.x.ai/
GROK_API_KEY=
GROK_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-3-mini

# ------------------------------------------------------------------ 4. IA Local (Ollama / LM Studio / vLLM)
# Exemplo Ollama: http://localhost:11434/v1 | LM Studio: http://localhost:1234/v1
LOCAL_LLM_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=qwen2.5:7b
LOCAL_LLM_API_KEY=ollama
LOCAL_EMBEDDING_MODEL=nomic-embed-text

# ------------------------------------------------------------------ 5. Antigravity / Modo Agente
# Permite delegar ao runtime Antigravity ou rodar com o sintetizador normativo embarcado
ANTIGRAVITY_MODE=enabled

# ------------------------------------------------------------------ 6. Servidor MCP da Operadora
# Suba com: docker compose up -d mcp
# Ou local: PYTHONPATH=mcp MCP_OPERADORA_DADOS=casos_treino MCP_OPERADORA_TOKEN=treino python -m mcp_operadora.server
MCP_OPERADORA_URL=http://localhost:9000/mcp
MCP_OPERADORA_TOKEN=treino
